# ---------------------------------------------------------------------------
# Space Relics — environment variables
# Copy to `.env` and fill in the values from `npx supabase status` (local)
# or from the Supabase dashboard (cloud).
# ---------------------------------------------------------------------------

# Public values. Safe to ship to the browser: Row Level Security protects data.
# Supabase Dashboard → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only value. NEVER expose it to the client or commit it.
# Prefer the new `sb_secret_...` key if your project has one.
NUXT_SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY

# Public base of the seed assets inside the `relic-media` bucket.
# `scripts/generate-seed.mjs` writes absolute URLs using this base.
SUPABASE_STORAGE_BASE=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/relic-media/assets

# ---------------------------------------------------------------------------
# Tooling (optional, only needed to run migrations / create the admin user)
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Used by `npm run setup:admin` to bootstrap the first administrator.
ADMIN_EMAIL=admin@spacerelics.space
ADMIN_PASSWORD=

# Base URL for `npm run smoke` (defaults to http://127.0.0.1:3000).
# BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Quiz com IA (admin) — provider OpenAI-compatible. Sem a key, a geração
# automática devolve 503 e resta o editor manual.
# ---------------------------------------------------------------------------
QUIZ_AI_API_KEY=
QUIZ_AI_BASE_URL=https://api.groq.com/openai/v1
QUIZ_AI_MODEL=openai/gpt-oss-120b
